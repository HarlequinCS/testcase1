# BookEase Lab — Apache Configuration
# VULN-10: Security headers intentionally ABSENT below.
# In a secure application these would all be enabled.

Options -Indexes

# Prevent direct directory listing
DirectoryIndex index.php index.html

# PHP error display (intentionally ON — VULN-09)
php_flag display_errors on
php_flag display_startup_errors on
php_value error_reporting E_ALL

# NOTE — VULN-10 Demo:
# The following headers are INTENTIONALLY NOT SET:
#
# Header always set Content-Security-Policy "default-src 'self'"
# Header always set X-Frame-Options "DENY"
# Header always set X-Content-Type-Options "nosniff"
# Header always set Referrer-Policy "strict-origin-when-cross-origin"
# Header always set Strict-Transport-Security "max-age=31536000"
